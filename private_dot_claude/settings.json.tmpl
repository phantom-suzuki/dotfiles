{
  {{- /* 上書き: data.claude.model で変更可。未定義なら現行 default。
         値は toString | toJson で「文字列化 + JSON エスケープ」してから埋め込む
         （quote や制御文字を含む値でも出力 JSON が壊れないようにするため）。 */}}
  "model": {{ dig "claude" "model" "claude-fable-5-1[1m]" . | toString | toJson }},
  {{- /*
    effortLevel は data.claude.effortLevel を定義したマシンでのみ出力する。
    未定義ならキー自体を出力しない（= ハーネス既定に従う。現行 main と同一出力）。
  */}}
  {{- if dig "claude" "effortLevel" "" . }}
  "effortLevel": {{ dig "claude" "effortLevel" "" . | toString | toJson }},
  {{- end }}
  {{- /*
    モデルごとの effort。用途別の使い分け（統括セッション = Fable 5.1 は high、担当セッション = Opus 5 は medium）を
    保存する。/effort は settings.json に直接書くため、マシン固有の値は data.claude.modelSettings で
    丸ごと上書きする。キーはモデル ID（`[1m]` などのサフィックスを除いた形）。
    用途別の起動コマンド（claude-plan / claude-work）は dot_zshrc.tmpl、説明は docs/chezmoi-workflow.md。
  */}}
  "modelSettings": {{ dig "claude" "modelSettings" (dict "claude-fable-5-1" (dict "effortLevel" "high") "claude-opus-5" (dict "effortLevel" "medium")) . | toJson }},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    {{- /*
      1M コンテキストの無効化（disable1m: "1"=無効 / "0"=明示的に有効）と
      auto-compact 窓（autoCompactWindow）は、data.claude.* を定義したマシンでのみ出力する。
      未定義ならキー自体を出力しない（= 1M 有効・窓はハーネス既定。現行 main と同一出力）。
      1M 無効化（200k 運用）にするマシンでは、autoCompactPct も 200k 前提の値
      （例: WINDOW=200000・PCT=65 で概ね 130k 到達時に compact 発火）へ合わせること。
      default の PCT=30 は 1M 有効（大コンテキスト）前提の値。
    */}}
    {{- if dig "claude" "disable1m" "" . }}
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": {{ dig "claude" "disable1m" "" . | toString | toJson }},
    {{- end }}
    {{- if dig "claude" "autoCompactWindow" "" . }}
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": {{ dig "claude" "autoCompactWindow" "" . | toString | toJson }},
    {{- end }}
    {{- /* 上書き: data.claude.autoCompactPct で変更可。未定義なら現行 default（30 = 1M 前提）。 */}}
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": {{ dig "claude" "autoCompactPct" "30" . | toString | toJson }}
  },
  {{- /* permissions / hooks は共通既定を維持する。許可コマンド未実行なら実害なしのため、個人差分の deny は各自がこのソース tmpl の deny リストを直接編集して対応する運用（deny 用の data 変数は未提供）。 */}}
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)",
      "Grep(*)",
      "Glob(*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git cherry-pick *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git worktree *)",
      "Bash(git remote *)",
      "Bash(git mv *)",
      "Bash(gh *)",
      "Bash(go *)",
      "Bash(golangci-lint *)",
      "Bash(mockgen *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(tsc *)",
      "Bash(eslint *)",
      "Bash(prettier *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(uv *)",
      "Bash(terraform *)",
      "Bash(terragrunt *)",
      "Bash(actionlint *)",
      "Bash(skeema *)",
      "Bash(atlas *)",
      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(make *)",
      "Bash(brew *)",
      "Bash(curl *)",
      "Bash(aws *)",
      "Bash(mysql *)",
      "Bash(MYSQL_PWD=* mysql *)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(test *)",
      "Bash(tree *)",
      "Bash(tree)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(rm /tmp/*)",
      "Bash(rm -r /tmp/*)",
      "Bash(rm -rf /tmp/*)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(which *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(date *)",
      "Bash(date)",
      "Bash(tr *)",
      "Bash(cut *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(xargs *)",
      "Bash(tee *)",
      "Bash(diff *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(tmux *)",
      "Bash(workmux *)",
      "Bash(claude *)",
      "LSP(*)",
      "Bash(find *)",
      "Bash(chezmoi *)",
      "Bash(rsync *)",
      "Bash(protoc *)",
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    {{- /*
      deny と ask の git ルールは、tameny-base プラグインの git-safety-check.sh が
      持っていた守りを引き取ったもの（2026-09-19）。プラグインを外した理由は、
      あのフックが gh pr merge のたびに無条件で確認を求め、事前に指示していても
      止まっていたこと。Claude Code にはフックを 1 つだけ無効にする設定が無く、
      止められるのはプラグイン単位だけなので、必要な守りだけをここへ書き写した。
      パターンの書き方は Claude Code 内蔵の既定ルールに合わせている
      （`git commit *--no-veri*` のように、途中の * が空文字にも一致する）。
    */}}
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git push *:main*)",
      "Bash(git push *:master*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push *refs/heads/master*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git rebase *)",
      {{- /* --no-verify: hooks を飛ばして壊れたまま進めるのを防ぐ。rebase は上で全面 deny 済み */}}
      "Bash(git commit *--no-veri*)",
      "Bash(git push *--no-veri*)",
      "Bash(git merge *--no-veri*)",
      {{- /* branch の強制削除。-d は未マージを検知して止まるので許す */}}
      "Bash(git branch -D*)",
      "Bash(git branch * -D*)",
      "Bash(git branch *--force*)",
      {{- /* 作業ツリーの全変更を捨てる形。退避するなら git stash を使う */}}
      "Bash(git checkout .)",
      "Bash(git checkout . *)",
      "Bash(git checkout -- .*)",
      "Bash(git checkout * -- .*)",
      "Bash(git restore .)",
      "Bash(git restore . *)",
      "Bash(git restore -- .*)",
      "Bash(git restore --worktree *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    {{- /*
      ask は許可リストより強く、auto mode でも確認を求める。
      main / master への push は上の deny が受け持つので、ここは develop と release/* だけ。
      gh pr merge は意図的に入れていない（毎回の確認をやめるのが移行の目的）。
    */}}
    "ask": [
      "Bash(git push origin develop)",
      "Bash(git push origin develop *)",
      "Bash(git push * develop)",
      "Bash(git push * develop *)",
      "Bash(git push *:develop*)",
      "Bash(git push *refs/heads/develop*)",
      "Bash(git push origin release/*)",
      "Bash(git push * release/*)",
      "Bash(git push *:release/*)",
      "Bash(git push *refs/heads/release/*)"
    ],
    {{- /* /permissions で切り替えた既定モードは settings.json に直接書かれる。data.claude.defaultMode で上書きする（未定義なら acceptEdits）。 */}}
    "defaultMode": {{ dig "claude" "defaultMode" "acceptEdits" . | toJson }}
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-codex-direct.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-question.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cleanup.sh",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/check-jargon.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notify.py",
            "timeout": 5,
            "once": true
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/precompact-snapshot.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/postcompact-reinject.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  {{- /*
    既定で有効にするプラグイン。scrum-penguin は既定から外した（スクラム運用していないリポジトリの
    セッションにも 16 本のスキル説明が毎回載るため）。スクラム運用するリポジトリでは、そのリポジトリの
    .claude/settings.json の enabledPlugins で有効化する（docs/chezmoi-workflow.md 参照）。
    マシン単位で足したいときは data.claude.enabledPlugins で丸ごと上書きする。
  */}}
  {{- /*
    tameny-base は 2026-09-19 に既定から外した。同梱のスキル 13 本はすべて
    private_dot_claude/skills/ に同名のものがあり、失うものは無い。外した理由は
    git-safety-check.sh が gh pr merge のたびに確認を求め、切る手段が
    プラグインごと無効にするしか無かったため。守りは上の deny / ask へ引き取った。
  */}}
  "enabledPlugins": {{ dig "claude" "enabledPlugins" (dict "gopls-lsp@claude-plugins-official" true "skill-creator@claude-plugins-official" true "codex@openai-codex" true) . | toJson }},
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "mationinc-claude-code-baseline": {
      "source": {
        "source": "github",
        "repo": "mationinc/claude-code-baseline"
      },
      "autoUpdate": true
    }
  },
  "language": "japanese",
  {{- /*
    音声入力（/voice）。data.claude.voice でマシンごとに上書きできる。
    mode は "hold"（押している間だけ録音・送信前に目視できる）か "tap"（タップで開始/停止・自動送信）。
    重要: /voice コマンドはこの値を settings.json に直接書き込むため、コマンドで変えたら
    chezmoi.toml の data.claude.voice も更新すること（更新しないと次の apply で巻き戻る）。
  */}}
  "voice": {{ dig "claude" "voice" (dict "enabled" true "mode" "hold" "autoSubmit" false) . | toJson }},
  "skipWorkflowUsageWarning": true,
  {{- /*
    --model フラグで起動したとき、セッション内のモデル切り替えを許すか。
    false にすると claude-plan / claude-work で指定したモデルが固定される。
  */}}
  "switchModelsOnFlag": {{ dig "claude" "switchModelsOnFlag" false . | toJson }},
  "teammateMode": "auto",
  "skipAutoPermissionPrompt": true,
  {{- /*
    auto mode の設定（soft_deny / environment）。/permissions の auto mode セットアップが settings.json に
    直接書き込むため、data.claude.autoMode に置かないと apply のたびに消える。未定義ならキー自体を出さない。
  */}}
  {{- with dig "claude" "autoMode" "" . }}
  "autoMode": {{ . | toJson }},
  {{- end }}
  {{/* ブラウザ MCP は全セッションで常駐すると重い（24 セッションで 4.3GB）。使うリポジトリごとに local scope で足す */}}
  "mcpServers": {{ dig "claude" "mcpServers" (dict) . | toJson }},
  "tui": "fullscreen"
}
